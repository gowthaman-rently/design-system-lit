{
  "name": "design-system-poc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm build:ui && pnpm -r --parallel dev",
    "dev:ui": "pnpm --filter @design-system-poc/ui dev",
    "dev:react": "pnpm --filter @design-system-poc/react-19 dev",
    "dev:next": "pnpm build:ui && pnpm --parallel --filter @design-system-poc/ui --filter @design-system-poc/next-16 dev",

    "build": "pnpm -r build",
    "build:ui": "pnpm --filter @design-system-poc/ui build",
    "build:react": "pnpm --filter @design-system-poc/react-19... build",
    "build:next": "pnpm --filter @design-system-poc/next-16... build",

    "preview": "pnpm -r --parallel preview",
    "preview:react": "pnpm --filter @design-system-poc/react-19 preview",
    "preview:next": "pnpm --filter @design-system-poc/next-16 preview",

    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  }
}
