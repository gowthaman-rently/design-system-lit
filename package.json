{
  "name": "design-system-poc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:ui": "pnpm --filter ui dev",
    "dev:react": "pnpm --filter react-19 dev",
    "dev:next": "pnpm --filter next-16 dev",
    "storybook": "pnpm --filter ui storybook",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --filter ui build && pnpm --recursive typecheck",
    "lint": "pnpm --recursive lint"
  }
}
