{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* Build: compile src/ to dist/ (.js + .d.ts) */
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "preserveWatchOutput": true
  },
  "include": ["src"]
}
